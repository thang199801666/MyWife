<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <LinearLayout
        android:id="@+id/settingsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView style="@style/SettingsTitle" android:text="@string/settings_title" />
        <Button android:id="@+id/appUpdateButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/app_update_check" android:textAllCaps="false" />

        <Button android:id="@+id/languageButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/language_title" android:textAllCaps="false" />

        <TextView style="@style/SettingsSection" android:text="@string/ui_enhancements" />
        <Button
            android:id="@+id/enhancedDefaultsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/ui_apply_enhanced_client_defaults"
            android:textAllCaps="false" />
        <Switch android:id="@+id/settingLightTheme" style="@style/SettingsSwitch" android:text="@string/ui_light_theme" />
        <Switch android:id="@+id/settingShield" style="@style/SettingsSwitch" android:text="@string/ui_block_youtube_ads" />
        <Switch android:id="@+id/settingTrackers" style="@style/SettingsSwitch" android:text="@string/ui_block_tracking_requests" />
        <Switch android:id="@+id/settingSafeMode" style="@style/SettingsSwitch" android:text="@string/ui_safe_mode_disable_network_and_aggressive_player_filtering" />

        <TextView style="@style/SettingsSection" android:text="@string/ui_distraction_control" />
        <Switch android:id="@+id/settingShorts" style="@style/SettingsSwitch" android:text="@string/ui_hide_shorts_and_open_shorts_as_normal_videos" />
        <Switch android:id="@+id/settingRecommendations" style="@style/SettingsSwitch" android:text="@string/ui_hide_related_recommendations" />
        <Switch android:id="@+id/settingComments" style="@style/SettingsSwitch" android:text="@string/ui_hide_comments" />
        <Switch android:id="@+id/settingEndScreen" style="@style/SettingsSwitch" android:text="@string/ui_hide_end_screen_cards" />
        <Switch android:id="@+id/settingOpenInApp" style="@style/SettingsSwitch" android:text="@string/ui_hide_open_in_app_prompts" />

        <TextView style="@style/SettingsSection" android:text="@string/ui_playback" />
        <Switch android:id="@+id/settingAutoPip" style="@style/SettingsSwitch" android:text="@string/ui_automatically_enter_pip_when_leaving_app" />
        <Switch android:id="@+id/settingBackgroundControls" style="@style/SettingsSwitch" android:text="@string/ui_lock_screen_notification_controls" />
        <Switch android:id="@+id/settingFullscreenGestures" style="@style/SettingsSwitch" android:text="@string/ui_player_gestures_swipe_down_to_minimize_fullscreen_seek_brightness" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_on_a_regular_video_page_swipe_down_on_the_video_image_to_minimize" android:textColor="?attr/appTextTertiary" android:textSize="12sp" android:paddingBottom="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_swipe_horizontally_to_seek_swipe_vertically_on_the_left_for_brigh" android:textColor="?attr/appTextTertiary" android:textSize="12sp" android:paddingBottom="6dp" />
        <Button android:id="@+id/gestureSensitivityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_gesture_sensitivity_1" android:textAllCaps="false" />
        <Button android:id="@+id/doubleTapSeekButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_double_tap_seek_10s" android:textAllCaps="false" />
        <Switch android:id="@+id/settingCompactChrome" style="@style/SettingsSwitch" android:text="@string/ui_minimal_player_chrome_hide_app_bar_while_watching" />
        <Switch android:id="@+id/settingShortsAutoHideChrome" style="@style/SettingsSwitch" android:text="@string/ui_shorts_auto_hide_controls" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_shorts_auto_hide_controls_description" android:textColor="?attr/appTextTertiary" android:textSize="12sp" android:paddingBottom="6dp" />
        <Switch android:id="@+id/settingAutoRepeat" style="@style/SettingsSwitch" android:text="@string/ui_always_repeat_the_current_video" />
        <Switch android:id="@+id/settingInactivityWarning" style="@style/SettingsSwitch" android:text="@string/inactivity_setting_enabled" />
        <Button android:id="@+id/inactivityTimeoutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/inactivity_setting_timeout_30" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/inactivity_setting_description" android:textColor="?attr/appTextTertiary" android:textSize="12sp" android:paddingBottom="6dp" />
        <Button android:id="@+id/preferredQualityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_wi_fi_unmetered_quality_auto" android:textAllCaps="false" />
        <Button android:id="@+id/mobileQualityButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_mobile_metered_quality_auto" android:textAllCaps="false" />

        <TextView style="@style/SettingsSection" android:text="@string/ui_community_segment_skip" />
        <Switch android:id="@+id/settingCommunitySponsorSkip" style="@style/SettingsSwitch" android:text="@string/ui_skip_sponsor_self_promo_and_interaction_segments" />
        <Switch android:id="@+id/settingSkipIntrosOutros" style="@style/SettingsSwitch" android:text="@string/ui_skip_community_marked_intros_and_outros" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/community_privacy" android:textColor="?attr/appTextTertiary" android:textSize="12sp" android:paddingBottom="6dp"/>

        <TextView style="@style/SettingsSection" android:text="@string/ui_reliability" />
        <Switch android:id="@+id/settingPlaybackRecovery" style="@style/SettingsSwitch" android:text="@string/ui_automatically_recover_stalled_foreground_playback" />
        <Switch android:id="@+id/settingScreenOffPlayback" style="@style/SettingsSwitch" android:text="@string/ui_keep_active_playback_reliable_with_screen_off_requires_notificati" />
        <Switch android:id="@+id/settingMemoryHardening" style="@style/SettingsSwitch" android:text="@string/ui_adaptive_webview_lifecycle_and_memory_hardening" />

        <TextView style="@style/SettingsSection" android:text="@string/ui_local_library" />
        <Switch android:id="@+id/settingPersonalization" style="@style/SettingsSwitch" android:text="@string/ui_learn_viewing_habits_locally_and_suggest_videos_in_for_you" />
        <Button android:id="@+id/resetPersonalizationButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_clear_learned_preferences_and_suggestions" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/appTextTertiary" android:textSize="12sp" android:text="@string/ui_learning_requires_watch_history_suggestions_use_viewing_time_favo" />
        <Switch android:id="@+id/settingRememberHistory" style="@style/SettingsSwitch" android:text="@string/ui_remember_watch_history_and_playback_position_locally" />
        <Switch android:id="@+id/settingResumePlayback" style="@style/SettingsSwitch" android:text="@string/ui_resume_videos_from_the_last_local_playback_position" />
        <Switch android:id="@+id/settingAutoAdvanceQueue" style="@style/SettingsSwitch" android:text="@string/ui_automatically_play_the_next_item_in_queue" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_subscriptions_favorites_queue_and_history_are_stored_only_on_this" android:textColor="?attr/appTextTertiary" android:textSize="12sp" android:paddingBottom="6dp"/>

        <TextView style="@style/SettingsSection" android:text="@string/ui_rule_pack" />
        <Switch android:id="@+id/settingAutoRuleUpdates" style="@style/SettingsSwitch" android:text="@string/ui_automatically_check_configured_rule_source_every_24_hours" />
        <TextView
            android:id="@+id/ruleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp"
            android:paddingVertical="8dp" />

        <EditText
            android:id="@+id/ruleUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:hint="https://…/videoshield-rules.json"
            android:textColor="?attr/appTextPrimary"
            android:textColorHint="?attr/appTextTertiary"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_address" />

        <Button
            android:id="@+id/updateRulesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/ui_check_install_rules" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/rollbackRulesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/ui_rollback" />

            <Button
                android:id="@+id/resetRulesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:layout_weight="1"
                android:text="@string/ui_bundled_rules" />
        </LinearLayout>

        <TextView style="@style/SettingsSection" android:text="@string/ui_channel_allowlist" />
        <TextView
            android:id="@+id/allowlistStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/appTextSecondary"
            android:textSize="13sp"
            android:paddingVertical="8dp" />
        <Button
            android:id="@+id/clearAllowlistButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/ui_clear_channel_allowlist" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/rules_explanation"
            android:textColor="?attr/appTextTertiary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/doneButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="24dp"
            android:text="@string/ui_done" />
    </LinearLayout>
</ScrollView>
