<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/libraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B0C0F">

    <LinearLayout
        android:id="@+id/libraryTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#15171C">
        <com.example.videoshield.IconButton android:id="@+id/closeLibraryButton" style="@style/ToolbarButton" android:contentDescription="@string/ui_back" android:drawableTop="@drawable/ic_ui_back"/>
        <TextView android:id="@+id/libraryTitle" android:visibility="gone" android:layout_width="0dp" android:layout_height="match_parent" android:gravity="center_vertical" android:text="@string/library" android:textColor="#F4F6FA" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/ui_you" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
        <com.example.videoshield.IconButton android:id="@+id/librarySearchToggle" style="@style/ToolbarButton" android:contentDescription="@string/ui_search_library" android:drawableTop="@drawable/ic_search"/>
        <com.example.videoshield.IconButton android:id="@+id/recommendationControlsButton" style="@style/ToolbarButton" android:contentDescription="@string/ui_library_options" android:drawableTop="@drawable/ic_ui_more"/>
        <Button android:id="@+id/clearLibraryButton" style="@style/BottomActionButton" android:layout_width="64dp" android:text="@string/ui_clear"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@mipmap/ic_launcher" android:contentDescription="@string/app_name"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingStart="16dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/library_subtitle" android:textColor="#AAAAAA" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingBottom="8dp" android:orientation="horizontal">
        <Button android:id="@+id/downloadsButton" style="@style/YouShortcutButton" android:text="@string/ui_downloads" android:drawableTop="@drawable/ic_ui_download"/>
        <Button android:id="@+id/eqButton" style="@style/YouShortcutButton" android:text="@string/eq" android:drawableTop="@drawable/ic_ui_eq"/>
        <Button android:id="@+id/aboutButton" style="@style/YouShortcutButton" android:text="@string/ui_about" android:drawableTop="@drawable/ic_ui_info"/>
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="52dp" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:paddingHorizontal="8dp" android:gravity="center_vertical">
        <Button android:id="@+id/forYouTab" style="@style/LibraryTabButton" android:layout_width="80dp" android:layout_weight="0" android:text="@string/ui_for_you"/>
        <Button android:id="@+id/relatedTab" style="@style/LibraryTabButton" android:layout_width="80dp" android:layout_weight="0" android:text="@string/ui_similar"/>
        <Button android:id="@+id/continueTab" style="@style/LibraryTabButton" android:layout_width="80dp" android:layout_weight="0" android:text="@string/ui_continue"/>
        <Button android:id="@+id/historyTab" style="@style/LibraryTabButton" android:layout_width="80dp" android:layout_weight="0" android:text="@string/ui_history"/>
        <Button android:id="@+id/favoritesTab" style="@style/LibraryTabButton" android:layout_width="80dp" android:layout_weight="0" android:text="@string/ui_favorites"/>
        <Button android:id="@+id/queueTab" style="@style/LibraryTabButton" android:layout_width="80dp" android:layout_weight="0" android:text="@string/ui_queue"/>
        <Button android:id="@+id/subscriptionsTab" style="@style/LibraryTabButton" android:layout_width="80dp" android:layout_weight="0" android:text="@string/channels"/>
    </LinearLayout>
    </HorizontalScrollView>

    <EditText android:id="@+id/librarySearch" android:visibility="gone" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="12dp" android:paddingHorizontal="16dp" android:background="@drawable/bg_address" android:hint="@string/search_titles" android:inputType="text" android:singleLine="true" android:imeOptions="actionSearch" android:textColor="#F4F6FA" android:textColorHint="#8B919D" android:textSize="14sp" android:maxLength="120"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/libraryList" android:layout_width="match_parent" android:layout_height="match_parent" android:dividerHeight="0dp" android:divider="@android:color/transparent"/>
        <TextView android:id="@+id/libraryEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/ui_nothing_here_yet" android:textColor="#8B919D" android:textSize="15sp"/>
    </FrameLayout>

    <com.example.videoshield.SwipeDismissLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="63dp"
        android:orientation="vertical"
        android:background="#15171C">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">
            <TextView android:id="@+id/nowPlayingText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:text="@string/nothing_playing" android:textColor="#E6E9EF" android:textSize="12sp"/>
            <com.example.videoshield.IconButton android:id="@+id/seekBackButton" android:contentDescription="@string/seek_back" style="@style/BottomActionButton" android:drawableTop="@drawable/ic_ui_seek_back"/>
            <com.example.videoshield.IconButton android:id="@+id/playPauseButton" android:contentDescription="@string/play_pause" style="@style/BottomActionButton" android:drawableTop="@drawable/ic_ui_play"/>
            <com.example.videoshield.IconButton android:id="@+id/seekForwardButton" android:contentDescription="@string/seek_forward" style="@style/BottomActionButton" android:drawableTop="@drawable/ic_ui_seek_forward"/>
            <com.example.videoshield.IconButton android:id="@+id/stopPlaybackButton" android:contentDescription="@string/close_player" style="@style/BottomActionButton" android:layout_width="42dp" android:drawableTop="@drawable/ic_ui_close"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/nowPlayingProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="1000"
            android:progressTint="#FF3358"
            android:progress="0" />
    </com.example.videoshield.SwipeDismissLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="55dp" android:orientation="horizontal" android:gravity="center">
        <Button android:id="@+id/navHomeButton" style="@style/BottomNavButton" android:drawableTop="@drawable/ic_nav_home" android:text="@string/ui_home"/>
        <Button android:id="@+id/navShieldButton" style="@style/BottomNavButton" android:drawableTop="@drawable/ic_nav_shorts" android:text="@string/shorts"/>
        <com.example.videoshield.IconButton android:id="@+id/navCreateButton" style="@style/BottomNavButton" android:contentDescription="@string/ui_quick_actions" android:drawableTop="@drawable/ic_ui_create"/>
        <Button android:id="@+id/navSubscriptionsButton" style="@style/BottomNavButton" android:drawableTop="@drawable/ic_nav_subscriptions" android:text="@string/ui_subscriptions"/>
        <Button android:id="@+id/navLibraryButton" style="@style/BottomNavButton" android:drawableTop="@drawable/ic_nav_you" android:text="@string/ui_you" android:textColor="#FFFFFF"/>
    </LinearLayout>
</LinearLayout>
