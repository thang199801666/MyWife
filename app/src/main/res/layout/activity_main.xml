<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:background="?attr/appSurface">

            <com.example.videoshield.IconButton
                android:id="@+id/backButton"
                style="@style/ToolbarButton"
                android:visibility="gone"
                android:contentDescription="@string/ui_back"
                android:drawableTop="@drawable/ic_ui_back" />
            <Button android:id="@+id/forwardButton" style="@style/ToolbarButton" android:visibility="gone" android:text="›" />
            <Button android:id="@+id/reloadButton" style="@style/ToolbarButton" android:visibility="gone" android:text="↻" />

            <LinearLayout
                android:id="@+id/brandContainer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/brandIcon"
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_brand_play"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/appBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/app_name"
                    android:textColor="?attr/appTextPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <EditText
                android:id="@+id/urlInput"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:hint="@string/search_youtube"
                android:textColor="?attr/appTextPrimary"
                android:textColorHint="?attr/appTextTertiary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_address" />

            <com.example.videoshield.IconButton
                android:id="@+id/notificationButton"
                style="@style/ToolbarButton"
                android:contentDescription="@string/ui_notifications"
                android:drawableTop="@drawable/ic_notifications" />

            <com.example.videoshield.IconButton
                android:id="@+id/goButton"
                style="@style/ToolbarButton"
                android:contentDescription="@string/ui_search"
                android:drawableTop="@drawable/ic_search" />

            <!-- Settings remains addressable for compatibility; it is exposed from Quick Actions/You. -->
            <com.example.videoshield.IconButton
                android:id="@+id/settingsButton"
                style="@style/ToolbarButton"
                android:visibility="gone"
                android:contentDescription="@string/ui_settings"
                android:drawableTop="@drawable/ic_ui_settings" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/browserContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Browse surface remains alive while a video is playing. -->
            <com.example.videoshield.HomePullRefreshLayout
                android:id="@+id/homePullRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <WebView
                    android:id="@+id/browseWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.example.videoshield.HomePullRefreshLayout>

            <!-- Dedicated playback surface. It can be expanded or collapsed into a mini-player. -->
            <com.example.videoshield.PlayerSurfaceLayout
                android:id="@+id/playerSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:visibility="gone">

                <com.example.videoshield.PlaybackWebView
                    android:id="@+id/webView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.example.videoshield.SwipeDismissLayout
                    android:id="@+id/miniPlayerChrome"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:background="?attr/appSurfaceElevated"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/miniPlayerTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="@string/playing_video"
                                android:textColor="?attr/appTextPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/miniPlayerChannel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="?attr/appTextSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.example.videoshield.IconButton android:id="@+id/miniPlayPauseButton" style="@style/MiniPlayerButton" android:contentDescription="@string/play_pause"  android:drawableTop="@drawable/ic_ui_pause"/>
                        <com.example.videoshield.IconButton android:id="@+id/miniExpandButton" style="@style/MiniPlayerButton" android:contentDescription="@string/expand_player"  android:drawableTop="@drawable/ic_ui_expand"/>
                        <com.example.videoshield.IconButton android:id="@+id/miniCloseButton" style="@style/MiniPlayerButton" android:contentDescription="@string/close_player"  android:drawableTop="@drawable/ic_ui_close"/>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/miniPlayerProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="1000"
                        android:progress="0"
                        android:indeterminate="false"
                        android:progressTint="#FF1744"
                        android:progressBackgroundTint="#505050" />
                </com.example.videoshield.SwipeDismissLayout>

                <LinearLayout
                    android:id="@+id/errorOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp"
                    android:background="#F2000000"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView android:id="@+id/errorTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/playback_unavailable" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:id="@+id/errorMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textColor="#BDBDBD" android:textSize="14sp" android:maxLines="4" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                        <Button android:id="@+id/errorRetryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/ui_retry" />
                        <Button android:id="@+id/errorHomeButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="8dp" android:text="@string/close_player" />
                    </LinearLayout>
                </LinearLayout>
            </com.example.videoshield.PlayerSurfaceLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/appSurface">

            <LinearLayout
                android:id="@+id/playbackStatusRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ToggleButton android:id="@+id/filterToggle" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:textOn="ON" android:textOff="OFF" />
                <TextView android:id="@+id/statusText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:ellipsize="end" android:maxLines="2" android:text="@string/ui_ready" android:textColor="?attr/appTextSecondary" android:textSize="11sp" />
                <Button android:id="@+id/channelButton" style="@style/CompactActionButton" android:visibility="gone" android:text="@string/ui_allow" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/playbackActionStrip"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:fillViewport="true"
                android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="8dp">
                    <Button android:id="@+id/minimizePlayerButton" style="@style/ClientActionButton" android:text="@string/ui_minimize" />
                    <Button android:id="@+id/autoNextButton" style="@style/ClientActionButton" android:text="@string/auto_next_on" />
                    <Button android:id="@+id/subscribeButton" style="@style/ClientActionButton" android:text="@string/ui_subscribe" android:enabled="false" />
                    <Button android:id="@+id/favoriteButton" style="@style/ClientActionButton" android:text="@string/ui_save" android:enabled="false" />
                    <Button android:id="@+id/queueButton" style="@style/ClientActionButton" android:text="@string/ui_queue" android:enabled="false" />
                    <Button android:id="@+id/speedButton" style="@style/ClientActionButton" android:text="1×" />
                    <Button android:id="@+id/qualityButton" style="@style/ClientActionButton" android:text="@string/ui_auto" />
                    <Button android:id="@+id/repeatButton" style="@style/ClientActionButton" android:text="@string/ui_repeat" />
                    <Button android:id="@+id/sleepButton" style="@style/ClientActionButton" android:text="@string/ui_sleep" />
                    <Button android:id="@+id/pipButton" style="@style/ClientActionButton" android:text="@string/pip" />
                </LinearLayout>
            </HorizontalScrollView>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/appDivider" />

            <LinearLayout
                android:id="@+id/navigationBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">
                <Button android:id="@+id/navHomeButton" style="@style/BottomNavButton" android:text="@string/ui_home" />
                <Button android:id="@+id/navShieldButton" style="@style/BottomNavButton" android:text="@string/shorts" />
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <com.example.videoshield.IconButton
                        android:id="@+id/navCreateButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:background="@drawable/bg_create_circle"
                        android:contentDescription="@string/ui_quick_actions"
                        android:drawableTop="@drawable/ic_plus" />
                </FrameLayout>
                <Button android:id="@+id/navSubscriptionsButton" style="@style/BottomNavButton" android:text="@string/ui_subscriptions" />
                <Button android:id="@+id/navLibraryButton" style="@style/BottomNavButton" android:text="@string/ui_you" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.example.videoshield.FullscreenGestureLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">
        <TextView
            android:id="@+id/fullscreenGestureFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#CC151515"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </com.example.videoshield.FullscreenGestureLayout>
</FrameLayout>
