<resources>
    <style name="ActionSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
    <style name="YouShortcutButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">@drawable/bg_action</item>
            <item name="android:drawableTint">?attr/appIconColor</item>
    </style>
    <style name="AppTheme" parent="AppThemeBlack" />

    <style name="AppThemeBlack" parent="AppThemeBlackBase" />
    <style name="AppThemeLight" parent="AppThemeLightBase" />

    <style name="AppThemeBlackBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:colorAccent">#FF3358</item>
        <item name="android:windowBackground">#000000</item>
        <item name="appBackground">#000000</item>
        <item name="appSurface">#0E0E0E</item>
        <item name="appSurfaceElevated">#171717</item>
        <item name="appControlSurface">#272727</item>
        <item name="appInputSurface">#24272E</item>
        <item name="appDivider">#242424</item>
        <item name="appTextPrimary">#FFFFFF</item>
        <item name="appTextSecondary">#C7CBD4</item>
        <item name="appTextTertiary">#8B919D</item>
        <item name="appBorder">#343842</item>
        <item name="appIconColor">#FFFFFF</item>
        <item name="appRipple">#40FFFFFF</item>
        <item name="appSectionAccent">#64B5F6</item>
        <item name="appSelectedSurface">#FFFFFF</item>
        <item name="appSelectedText">#111318</item>
    </style>

    <style name="AppThemeLightBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAFAFA</item>
        <item name="android:navigationBarColor">#FAFAFA</item>
        <item name="android:colorAccent">#FF3358</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="appBackground">#FAFAFA</item>
        <item name="appSurface">#FFFFFF</item>
        <item name="appSurfaceElevated">#F3F4F6</item>
        <item name="appControlSurface">#ECEFF3</item>
        <item name="appInputSurface">#F1F3F6</item>
        <item name="appDivider">#D9DDE3</item>
        <item name="appTextPrimary">#111318</item>
        <item name="appTextSecondary">#4F5662</item>
        <item name="appTextTertiary">#747B86</item>
        <item name="appBorder">#D8DDE5</item>
        <item name="appIconColor">#20242B</item>
        <item name="appRipple">#1F000000</item>
        <item name="appSectionAccent">#1565C0</item>
        <item name="appSelectedSurface">#111318</item>
        <item name="appSelectedText">#FFFFFF</item>
    </style>

    <style name="ToolbarButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="BottomActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>

    <style name="SettingsSection" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appSectionAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="SettingsSwitch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="CompactActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">9sp</item>
        <item name="android:padding">2dp</item>
    </style>

    <style name="BottomNavButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textAllCaps">false</item>
            <item name="android:drawableTint">?attr/appIconColor</item>
    </style>

    <style name="LibraryTabButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DashboardCard" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DashboardNumber" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical|end</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ClientActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/bg_action</item>
    </style>

    <style name="MiniPlayerButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
    </style>

</resources>
