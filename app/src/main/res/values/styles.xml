<resources>
    <style name="ActionSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
    <style name="YouShortcutButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginHorizontal">@dimen/ui_space_xs</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">@dimen/ui_space_sm</item>
        <item name="android:padding">@dimen/ui_space_sm</item>
        <item name="android:background">@drawable/bg_action</item>
            <item name="android:drawableTint">?attr/appIconColor</item>
    </style>
    <style name="AppTheme" parent="AppThemeBlack" />

    <style name="AppThemeBlack" parent="AppThemeBlackBase" />
    <style name="AppThemeLight" parent="AppThemeLightBase" />

    <style name="AppThemeBlackBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0F0F0F</item>
        <item name="android:navigationBarColor">#0F0F0F</item>
        <item name="android:colorAccent">#FF3358</item>
        <item name="android:windowBackground">#0F0F0F</item>
        <item name="appBackground">#0F0F0F</item>
        <item name="appSurface">#0F0F0F</item>
        <item name="appSurfaceElevated">#212121</item>
        <item name="appControlSurface">#272727</item>
        <item name="appInputSurface">#272727</item>
        <item name="appDivider">#2A2A2A</item>
        <item name="appTextPrimary">#FFFFFF</item>
        <item name="appTextSecondary">#AAAAAA</item>
        <item name="appTextTertiary">#8A8A8A</item>
        <item name="appBorder">#3A3A3A</item>
        <item name="appIconColor">#FFFFFF</item>
        <item name="appRipple">#26FFFFFF</item>
        <item name="appSectionAccent">#64B5F6</item>
        <item name="appSelectedSurface">#FFFFFF</item>
        <item name="appSelectedText">#111318</item>
        <item name="appProgressAccent">#FF0033</item>
    </style>

    <style name="AppThemeLightBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:colorAccent">#FF3358</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="appBackground">#FFFFFF</item>
        <item name="appSurface">#FFFFFF</item>
        <item name="appSurfaceElevated">#F2F2F2</item>
        <item name="appControlSurface">#F2F2F2</item>
        <item name="appInputSurface">#F2F2F2</item>
        <item name="appDivider">#E5E5E5</item>
        <item name="appTextPrimary">#111318</item>
        <item name="appTextSecondary">#606060</item>
        <item name="appTextTertiary">#757575</item>
        <item name="appBorder">#DADADA</item>
        <item name="appIconColor">#20242B</item>
        <item name="appRipple">#1F000000</item>
        <item name="appSectionAccent">#1565C0</item>
        <item name="appSelectedSurface">#111318</item>
        <item name="appSelectedText">#FFFFFF</item>
        <item name="appProgressAccent">#FF0033</item>
    </style>

    <style name="ToolbarButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
        <item name="android:layout_width">@dimen/ui_toolbar_button_size</item>
        <item name="android:layout_height">@dimen/ui_toolbar_button_size</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="BottomActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsTitle" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>

    <style name="SettingsSection" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/appSectionAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="SettingsSwitch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="CompactActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">9sp</item>
        <item name="android:padding">2dp</item>
    </style>

    <style name="BottomNavButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:drawablePadding">1dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawableTint">?attr/appIconColor</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="LibraryTabButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:layout_marginHorizontal">@dimen/ui_space_xs</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">@dimen/ui_action_height</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="DashboardCard" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DashboardNumber" parent="android:style/TextAppearance.Material.Headline">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:gravity">center_vertical|end</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ClientActionButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/ui_action_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">@dimen/ui_space_lg</item>
        <item name="android:layout_marginHorizontal">@dimen/ui_space_xs</item>
        <item name="android:background">@drawable/bg_action</item>
        <item name="android:drawableTint">?attr/appIconColor</item>
        <item name="android:drawablePadding">@dimen/ui_space_sm</item>
    </style>

    <style name="ClientActionIconButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">@dimen/ui_action_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:layout_marginHorizontal">@dimen/ui_space_xs</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/bg_action</item>
    </style>

    <style name="MiniPlayerButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
        <item name="android:layout_width">@dimen/ui_toolbar_button_size</item>
        <item name="android:layout_height">@dimen/ui_toolbar_button_size</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="MiniPlayerOverlayButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:stateListAnimator">@animator/ui_press_scale</item>
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/bg_mini_control</item>
    </style>


    <style name="YouTextSectionTitle" parent="android:style/TextAppearance.Material.Title">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="YouTextCardTitle" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="YouTextShortcutTitle" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="YouTextMetadata" parent="android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="YouTextViewAll" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="YouTextActionTitle" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?attr/appTextPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="YouTextSupporting" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?attr/appTextSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
